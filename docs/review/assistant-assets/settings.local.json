{
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(curl:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:kubernetes.io)",
      "WebFetch(domain:redhat.com)",
      "WebFetch(domain:openshift.com)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)"
    ]
  }
}
